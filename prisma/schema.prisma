generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["erp", "auth"]
}

model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz

  // Teams Integration settings
  teams_enabled        Boolean  @default(false)
  teams_tenant_id      String?
  teams_client_id      String?
  teams_client_secret  String?

  users             User[]
  clients           Client[]
  scope_templates   ScopeTemplate[]
  workflows         Workflow[]
  tasks             Task[]
  blockers          Blocker[]
  activity_logs     ActivityLog[]
  task_comments     TaskComment[]
  task_attachments  TaskAttachment[]
  task_logs         TaskLog[]
  time_entries      TimeEntry[]
  notifications     Notification[]
  notification_prefs NotificationPreference[]
  history           History[]
  client_users      ClientUser[]

  @@map("tenants")
  @@schema("erp")
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String

  users User[]

  @@map("roles")
  @@schema("erp")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  role_id          String    @db.Uuid
  auth_user_id     String    @unique @db.Uuid
  email            String
  microsoft_id     String?   @unique
  full_name        String
  avatar_url       String?
  is_active        Boolean   @default(true)
  last_login       DateTime? @db.Timestamptz
  hourly_cost_rate Decimal?  @db.Decimal(12, 2)
  billable_rate    Decimal?  @db.Decimal(12, 2)
  skills           Json      @default("[]")
  designation      String?
  experience       String?
  availability     String?
  current_workload Decimal?  @db.Decimal(5, 2)
  team             String?
  created_by       String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  tenant              Tenant                   @relation(fields: [tenant_id], references: [id])
  role                Role                     @relation(fields: [role_id], references: [id])
  created_clients     Client[]                 @relation("ClientCreatedBy")
  created_templates   ScopeTemplate[]          @relation("ScopeTemplateCreatedBy")
  managed_workflows   Workflow[]               @relation("WorkflowProjectManager")
  assigned_tasks      Task[]                   @relation("TaskAssignedTo")
  completed_tasks     Task[]                   @relation("TaskCompletedBy")
  flagged_blockers    Blocker[]                @relation("BlockerFlaggedBy")
  resolved_blockers   Blocker[]                @relation("BlockerResolvedBy")
  assigned_blockers   Blocker[]                @relation("BlockerAssignedTo")
  assigned_by_tasks   Task[]                   @relation("TaskAssignedBy")
  activity_logs       ActivityLog[]
  task_comments       TaskComment[]
  task_attachments    TaskAttachment[]
  task_logs           TaskLog[]
  time_entries        TimeEntry[]
  notifications       Notification[]
  notification_prefs  NotificationPreference[]
  history             History[]
  client_users        ClientUser[]

  @@index([tenant_id])
  @@index([tenant_id, created_at])
  @@map("users")
  @@schema("erp")
}

model Client {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  name              String
  industry          String
  service_type      String
  contact_name      String?
  contact_email     String?
  contact_phone     String?
  address           String?
  status            String   @default("active")
  monthly_retainer  Decimal? @db.Decimal(12, 2)
  currency          String   @default("INR")
  contract_duration Int?
  contract_start    DateTime? @db.Date
  contract_end      DateTime? @db.Date
  payment_terms     String?
  renewal_date      DateTime? @db.Date
  notes             String?
  brand_url         String?
  instagram_profile String?
  social_profiles   Json      @default("{}")
  brand_guidelines  String?
  logo_assets       Json      @default("[]")
  color_palette     Json      @default("[]")
  fonts             Json      @default("[]")
  target_audience   String?
  competitor_list   Json      @default("[]")
  positioning_statement String?
  campaign_history      Json  @default("[]")
  communication_history Json  @default("[]")
  scope_template_id String?  @db.Uuid
  health_score      Decimal? @db.Decimal(5, 2)
  retainer_hours    Int?
  created_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  ad_spend          Decimal? @db.Decimal(12, 2)
  total_investment  Decimal? @db.Decimal(12, 2)
  invoice_status    String?
  next_invoice_date DateTime? @db.Date

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  scope_template ScopeTemplate? @relation(fields: [scope_template_id], references: [id])
  creator        User           @relation("ClientCreatedBy", fields: [created_by], references: [id])
  workflows      Workflow[]
  blockers       Blocker[]
  client_users   ClientUser[]
  tasks          Task[]         @relation("ClientTasks")

  @@index([tenant_id, status, created_at])
  @@map("clients")
  @@schema("erp")
}

model ScopeTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  name            String
  industry        String
  service_type    String
  description     String?
  duration_months Int
  default_tasks   Json     @default("[]")
  kpi_framework   Json     @default("{}")
  is_active       Boolean  @default(true)
  created_by      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @updatedAt @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  creator   User       @relation("ScopeTemplateCreatedBy", fields: [created_by], references: [id])
  clients   Client[]
  workflows Workflow[]

  @@index([tenant_id, is_active])
  @@unique([tenant_id, industry, service_type])
  @@map("scope_templates")
  @@schema("erp")
}

model Workflow {
  id                    String   @id @default(uuid()) @db.Uuid
  tenant_id             String   @db.Uuid
  client_id             String   @db.Uuid
  template_id           String?  @db.Uuid
  project_manager_id    String?  @db.Uuid
  title                 String
  status                String   @default("active")
  month_number          Int
  completion_percentage Decimal  @default(0) @db.Decimal(5, 2)
  start_date            DateTime? @db.Date
  end_date              DateTime? @db.Date
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @updatedAt @db.Timestamptz
  auto_generated        Boolean  @default(true)

  tenant          Tenant         @relation(fields: [tenant_id], references: [id])
  client          Client         @relation(fields: [client_id], references: [id])
  template        ScopeTemplate? @relation(fields: [template_id], references: [id])
  project_manager User?          @relation("WorkflowProjectManager", fields: [project_manager_id], references: [id])
  tasks           Task[]

  @@index([tenant_id, client_id, month_number])
  @@index([tenant_id, status, created_at])
  @@map("workflows")
  @@schema("erp")
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  workflow_id    String?   @db.Uuid
  assigned_to    String?   @db.Uuid
  parent_task_id String?   @db.Uuid
  completed_by   String?   @db.Uuid
  title          String
  description    String?
  status         String    @default("yet_to_start")
  priority       String    @default("medium")
  sort_order     Int       @default(0)
  due_date       DateTime? @db.Timestamptz
  start_date     DateTime? @db.Date
  labels         String[]  @default([])
  recurrence_series_id String?   @db.Uuid
  recurrence_rule      String?
  recurrence_end_date  DateTime? @db.Date
  recurrence_type      String?
  depends_on     String[]  @db.Uuid
  is_subtask     Boolean   @default(false)
  is_daily       Boolean   @default(false)
  completed_at   DateTime? @db.Timestamptz
  checklist      Json?     @default("[]")
  slot           String?
  client_id               String?   @db.Uuid
  blocked_previous_status String?   @db.VarChar(50)
  assigned_by             String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz
  updated_at              DateTime  @updatedAt @db.Timestamptz

  tenant        Tenant    @relation(fields: [tenant_id], references: [id])
  workflow      Workflow? @relation(fields: [workflow_id], references: [id])
  client        Client?   @relation("ClientTasks", fields: [client_id], references: [id], onDelete: Cascade)
  assignee      User?     @relation("TaskAssignedTo", fields: [assigned_to], references: [id])
  completer     User?     @relation("TaskCompletedBy", fields: [completed_by], references: [id])
  assignor      User?     @relation("TaskAssignedBy", fields: [assigned_by], references: [id])
  parent_task   Task?     @relation("TaskHierarchy", fields: [parent_task_id], references: [id])
  subtasks      Task[]    @relation("TaskHierarchy")
  blockers      Blocker[]
  comments      TaskComment[]
  attachments   TaskAttachment[]
  task_logs     TaskLog[]
  time_entries  TimeEntry[]

  @@index([tenant_id, workflow_id])
  @@index([tenant_id, assigned_to])
  @@index([tenant_id, status, due_date])
  @@map("tasks")
  @@schema("erp")
}

model Blocker {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  task_id          String    @db.Uuid
  client_id        String    @db.Uuid
  flagged_by       String    @db.Uuid
  resolved_by      String?   @db.Uuid
  assigned_to      String?   @db.Uuid
  title            String
  description      String?
  severity         String    @default("medium")
  status           String    @default("open")
  impact           String?
  resolution_notes String?
  notify           Json?     @default("[]")
  flagged_at       DateTime  @default(now()) @db.Timestamptz
  resolved_at      DateTime? @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  tenant   Tenant @relation(fields: [tenant_id], references: [id])
  task     Task   @relation(fields: [task_id], references: [id])
  client   Client @relation(fields: [client_id], references: [id])
  flagger  User   @relation("BlockerFlaggedBy", fields: [flagged_by], references: [id])
  resolver User?  @relation("BlockerResolvedBy", fields: [resolved_by], references: [id])
  assignee User?  @relation("BlockerAssignedTo", fields: [assigned_to], references: [id])

  @@index([tenant_id, status, created_at])
  @@index([tenant_id, status, flagged_at])
  @@index([tenant_id, severity, status])
  @@index([tenant_id, client_id, status])
  @@index([tenant_id, task_id, status])
  @@map("blockers")
  @@schema("erp")
}

model ActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  user_id       String?  @db.Uuid
  action_type   String
  entity_type   String
  entity_id     String   @db.Uuid
  before_values Json?
  after_values  Json?
  created_at    DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User?  @relation(fields: [user_id], references: [id])

  @@index([tenant_id, created_at])
  @@map("activity_logs")
  @@schema("erp")
}

model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  task_id    String   @db.Uuid
  author_id  String   @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  task   Task   @relation(fields: [task_id], references: [id])
  author User   @relation(fields: [author_id], references: [id])

  @@map("task_comments")
  @@schema("erp")
}

model TaskAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  task_id    String   @db.Uuid
  uploaded_by String  @db.Uuid
  file_name  String
  file_url   String
  file_size  Int
  mime_type  String
  created_at DateTime @default(now()) @db.Timestamptz

  tenant   Tenant @relation(fields: [tenant_id], references: [id])
  task     Task   @relation(fields: [task_id], references: [id])
  uploader User   @relation(fields: [uploaded_by], references: [id])

  @@map("task_attachments")
  @@schema("erp")
}

model TimeEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  task_id     String   @db.Uuid
  user_id     String   @db.Uuid
  hours       Decimal  @db.Decimal(6, 2)
  date        DateTime @db.Date
  description String?
  is_billable Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  task   Task   @relation(fields: [task_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@map("time_entries")
  @@schema("erp")
}

model Notification {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  user_id             String    @db.Uuid
  type                String
  title               String
  message             String
  is_read             Boolean   @default(false)
  related_entity_type String?
  related_entity_id   String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz
  read_at             DateTime? @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@map("notifications")
  @@schema("erp")
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  user_id           String   @db.Uuid
  notification_type String
  in_app_enabled    Boolean  @default(true)
  email_enabled     Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, user_id, notification_type])
  @@map("notification_preferences")
  @@schema("erp")
}

model History {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  date       DateTime @db.Date
  payload    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@index([tenant_id, user_id, date])
  @@map("history")
  @@schema("erp")
}

model ClientUser {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  client_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])
  client Client @relation(fields: [client_id], references: [id])

  @@unique([tenant_id, user_id, client_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([client_id])
  @@map("client_users")
  @@schema("erp")
}

model TaskLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  task_id     String   @db.Uuid
  user_id     String   @db.Uuid
  field       String
  old_value   String?
  new_value   String?
  reason      String?
  created_at  DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  task   Task   @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  @@index([tenant_id, task_id])
  @@map("task_logs")
  @@schema("erp")
}
